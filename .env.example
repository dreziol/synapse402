# ==============================================================================
# Synapse402 Environment Configuration (Tempo L1 Moderato Testnet)
# ==============================================================================

# 1. Network RPC & Chain Configuration
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
TEMPO_CHAIN_ID=42431

# 2. Deployer / Relayer Private Key (Exported from MetaMask or generated via Hardhat)
# When set, Synapse402 automatically executes real on-chain transactions over Tempo L1.
# If omitted, Synapse402 operates in Resilient EIP-712 / Merkle Local Sandbox mode.
PRIVATE_KEY=
TEMPO_RELAYER_KEY=

# Public-origin live writes are disabled by default. Enable only behind an
# application login/session gate; local demo requests remain available.
SYNAPSE_ALLOW_PUBLIC_LIVE=false

# 3. Deployed Smart Contract Addresses on Tempo L1
# Generated automatically after running: npx hardhat run scripts/deploy.ts --network tempoTestnet
TEMPO_VAULT_ADDRESS=0x3c42E274FAdd8e371fB84f97203CC2F2125c8775
TEMPO_RECEIVER_ADDRESS=0xfCEb1a2633881c19283836a2E17Ba25E612724A0
TEMPO_PATHUSD_ADDRESS=0x9aa3ef4B60B6e3c440711658ee05780e236ac714

# 4. Gateway Server Port
PORT=3001
