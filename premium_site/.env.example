# ==============================================================================
# Synapse402 Premium Site & Gateway Configuration
# ==============================================================================

PORT=3001
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
TEMPO_CHAIN_ID=42431

# Optional relayer wallet for on-chain machine settlements
# Keep this server-side and set an explicit high-entropy session secret in production.
PRIVATE_KEY=
TEMPO_RELAYER_KEY=
# Optional separate owner key for owner-only vault policy updates. Required
# when the relayer is not the configured SynapseVault owner.
TEMPO_VAULT_OWNER_KEY=
SYNAPSE_SESSION_MASTER_SECRET=

# Public-origin live writes are disabled by default. Enable only behind an
# application login/session gate; local demo requests remain available.
SYNAPSE_ALLOW_PUBLIC_LIVE=false

# Deployed Contract Addresses on Tempo Moderato
TEMPO_VAULT_ADDRESS=0x3c42E274FAdd8e371fB84f97203CC2F2125c8775
TEMPO_RECEIVER_ADDRESS=0xfCEb1a2633881c19283836a2E17Ba25E612724A0
TEMPO_PATHUSD_ADDRESS=0x9aa3ef4B60B6e3c440711658ee05780e236ac714
